ENVIRONMENT=development
APP_NAME="Leely API"
VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Set this to the frontend's origin (scheme + host + port, without a path).
FRONTEND_ORIGINS=http://localhost:5173

# Required for the resource-search endpoint. Replace with your own Tavily key.
TRAVILY_API_KEY=replace-with-your-tavily-api-key

# Optional. Leave empty to disable Sentry reporting locally.
SENTRY_URL=